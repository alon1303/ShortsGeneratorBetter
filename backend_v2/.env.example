# ShortsGenerator Backend v2 - Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================
# Application Settings
# ============================================
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ============================================
# Reddit API Configuration (Public JSON Endpoints)
# ============================================
# Using Reddit's public JSON endpoints - no API keys required!
# Set a realistic User-Agent to prevent blocks
REDDIT_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Reddit Story Settings
DEFAULT_SUBREDDIT=AskReddit
DEFAULT_TIME_FILTER=day  # hour, day, week, month, year, all
MIN_STORY_SCORE=100
MIN_STORY_LENGTH=200
MAX_STORY_LENGTH=5000
EXCLUDE_NSFW=true
WORDS_PER_MINUTE=188

# ============================================
# TTS Engine Configuration
# ============================================
# Choose TTS engine: 'edge' (free) or 'elevenlabs' (paid)
TTS_ENGINE=edge

# ============================================
# ElevenLabs API Configuration (for Phase 2)
# ============================================
# Get your API key from: https://elevenlabs.io/app
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice IDs (pre-configured for popular Shorts narrator voices)
ELEVENLABS_VOICE_RACHEL=21m00Tcm4TlvDq8ikWAM  # Professional female
ELEVENLABS_VOICE_ADAM=pNInz6obpgDQGcFmaJgB    # Deep male
ELEVENLABS_VOICE_ELLI=MF3mGyEYCl7XYWbV9V6O    # Young female
ELEVENLABS_VOICE_JOSH=TxGEqnHWrfWFTfGW9XjX    # Casual male
DEFAULT_VOICE_ID=en-US-AriaNeural

# ============================================
# Background Video Settings
# ============================================
DEFAULT_BACKGROUND_THEME=minecraft
MIN_BACKGROUND_DURATION=60
MAX_BACKGROUND_DURATION=300

# ============================================
# Video Processing Settings
# ============================================
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
VIDEO_CRF=23
VIDEO_PRESET=veryfast
AUDIO_BITRATE=128k

# ============================================
# Story Segmentation Settings
# ============================================
MIN_PART_DURATION=30
MAX_PART_DURATION=60
MAX_PARTS=5

# ============================================
# File Upload Settings
# ============================================
MAX_FILE_SIZE_MB=100
ALLOWED_EXTENSIONS=.mp4,.avi,.mkv,.mov,.webm

# ============================================
# Caching Settings
# ============================================
CACHE_TTL=3600
ENABLE_CACHE=true

# ============================================
# Directory Paths (relative to backend_v2/)
# ============================================
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
CACHE_DIR=cache
ASSETS_DIR=assets
BACKGROUNDS_DIR=assets/backgrounds

# ============================================
# YouTube API Configuration
# ============================================
# Google Cloud Console OAuth2 credentials
# Obtain from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_google_project_id_here